# .env.example — SAFE TO COMMIT. Contains NO real secrets, only placeholders.
#
# HOW THIS WORKS:
#   1. Copy this file to a new file named exactly ".env" (same folder).
#   2. Replace every placeholder value below with a real one.
#   3. Never commit ".env" itself — only this .example file is tracked in git.
#
# Setup (one-time, per teammate):
#   Windows (PowerShell):   copy .env.example .env
#   Mac/Linux:               cp .env.example .env
#   Then open .env and fill in real values.

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (or ask a teammate who has one already)
JWT_SECRET=changeme-generate-a-real-random-value

# ── Field-level encryption (medicalNotes, knownThreats, etc.) ───────────────
# Generate with: openssl rand -base64 32
# WARNING: once real data has been encrypted with a value, changing it later
# makes that data permanently unreadable unless you run a migration first.
# Ask in the team chat before regenerating this if unsure whether real data
# already exists under the current value.
ENCRYPTION_KEY=changeme-generate-a-real-random-value

# ── Contract e-signature link signing ───────────────────────────────────────
# Generate with: openssl rand -hex 32
# This signs every contract-signing URL — treat it as seriously as JWT_SECRET.
CONTRACTING_SIGNING_SECRET=changeme-generate-a-real-random-value

# ── SMS (BulkSMS) — optional, leave SMS_ENABLED=false if you don't have credentials ──
SMS_ENABLED=false
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
BULKSMS_SENDER_ID=

# ── Frontend URL (used to build links in emails) ────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Contracting module ownership defaults ───────────────────────────────────
CONTRACTING_OWNER_NAME=HandyFlow Admin
CONTRACTING_OWNER_EMAIL=changeme@yourcompany.co.za
